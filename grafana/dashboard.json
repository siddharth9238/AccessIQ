{
  "dashboard": {
    "id": null,
    "title": "AccessIQ Application Dashboard",
    "tags": ["accessiq", "spring-boot", "prometheus"],
    "timezone": "browser",
    "schemaVersion": 36,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "Application Health",
        "type": "stat",
        "datasource": null,
        "targets": [
          {
            "expr": "up{job=\"accessiq\"}",
            "legendFormat": "",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "red",
                  "value": null
                },
                {
                  "color": "green",
                  "value": 1
                }
              ]
            }
          }
        },
        "gridPos": {
          "h": 4,
          "w": 4,
          "x": 0,
          "y": 0
        }
      },
      {
        "id": 2,
        "title": "HTTP Request Rate",
        "type": "graph",
        "datasource": null,
        "targets": [
          {
            "expr": "rate(http_server_requests_seconds_count{job=\"accessiq\"}[5m])",
            "legendFormat": "{{method}} {{uri}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        }
      },
      {
        "id": 3,
        "title": "JVM Memory Usage",
        "type": "graph",
        "datasource": null,
        "targets": [
          {
            "expr": "jvm_memory_used_bytes{job=\"accessiq\"}",
            "legendFormat": "{{area}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "bytes"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 0
        }
      },
      {
        "id": 4,
        "title": "Database Connections",
        "type": "graph",
        "datasource": null,
        "targets": [
          {
            "expr": "hikaricp_connections_active{job=\"accessiq\"}",
            "legendFormat": "Active Connections",
            "refId": "A"
          },
          {
            "expr": "hikaricp_connections_idle{job=\"accessiq\"}",
            "legendFormat": "Idle Connections",
            "refId": "B"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 8
        }
      },
      {
        "id": 5,
        "title": "HTTP Response Time",
        "type": "graph",
        "datasource": null,
        "targets": [
          {
            "expr": "rate(http_server_requests_seconds_sum{job=\"accessiq\"}[5m]) / rate(http_server_requests_seconds_count{job=\"accessiq\"}[5m])",
            "legendFormat": "Average Response Time",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 8
        }
      }
    ]
  }
}