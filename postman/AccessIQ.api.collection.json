{
  "info": {
    "name": "AccessIQ API",
    "schema": {
      "type": "https"
    },
    "version": "1.0.0",
    "description": "AccessIQ Workflow & Approval System API Collection"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@accessiq.com\",\n  \"password\": \"Admin@123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "href": "{{baseUrl}}/api/v1/auth/login"
            }
          },
          "response": []
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/refresh",
              "href": "{{baseUrl}}/api/v1/auth/refresh"
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Requests",
      "item": [
        {
          "name": "Create Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Leave Request\",\n  \"description\": \"Vacation leave for 5 days\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/requests",
              "href": "{{baseUrl}}/api/v1/requests"
            }
          },
          "response": []
        },
        {
          "name": "Get Requests",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/requests",
              "href": "{{baseUrl}}/api/v1/requests"
            }
          },
          "response": []
        },
        {
          "name": "Approve Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"details\": \"Approved for vacation\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/requests/1/approve",
              "href": "{{baseUrl}}/api/v1/requests/1/approve"
            }
          },
          "response": []
        },
        {
          "name": "Reject Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"details\": \"Insufficient documentation\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/requests/1/reject",
              "href": "{{baseUrl}}/api/v1/requests/1/reject"
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Get Users",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/users",
              "href": "{{baseUrl}}/api/v1/admin/users"
            }
          },
          "response": []
        },
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newuser@accessiq.com\",\n  \"password\": \"Password123!\",\n  \"roles\": [\"EMPLOYEE\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/users",
              "href": "{{baseUrl}}/api/v1/admin/users"
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Audit",
      "item": [
        {
          "name": "Get Audit Logs",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/audit/logs",
              "href": "{{baseUrl}}/api/v1/audit/logs"
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Health Check",
      "item": [
        {
          "name": "Test Endpoint",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/test",
              "href": "{{baseUrl}}/test"
            }
          },
          "response": []
        },
        {
          "name": "Health Endpoint",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "href": "{{baseUrl}}/actuator/health"
            }
          },
          "response": []
        },
        {
          "name": "Metrics Endpoint",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/actuator/metrics",
              "href": "{{baseUrl}}/actuator/metrics"
            }
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    }
  ]
}